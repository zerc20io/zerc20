; Only versions published a week ago or earlier install: a hijacked release is most often found and pulled within days.
; A lockfile installs as it stands, but npm also looks up a peer the lockfile leaves unmet, under this same rule; where
; that fails, `npm ci --min-release-age=0` installs it, as the workflows do. npm reads only the .npmrc beside a
; package.json, so each package's links here.
min-release-age=7
