            mstore(add(f, 512), LINK_C_2_Y_1)
            mstore(add(f, 544), LINK_C_2_Y_0)
            // Link_pi, -Link_A
            calldatacopy(add(f, 576), add(proof, 0x140), 0x40)
            mstore(add(f, 640), LINK_A_NEG_X_1)
            mstore(add(f, 672), LINK_A_NEG_X_0)
